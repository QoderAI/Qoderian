# Build output (regenerated by `npm run build`, published via GitHub Releases)
# Anchored to the repository root so tracked sources such as
# scripts/dev-reloader/main.js are not swept up.
/main.js
/styles.css
*.js.map
dist/
build/

# Dependencies
node_modules/

# Logs
*.log

# Environment variables
.env
.env*.local

# Editors
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# Caches
.eslintcache

# Vault-local state, not source
.obsidian/
/data.json
.qoderian/
.qoder/

# Local preview material, not shipped
/docs/preview/
